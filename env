# Qdrant Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# OpenRouter API Configuration (for LLM)
OPENROUTER_API_KEY=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
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-3-haiku:beta
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# Embedding Configuration (bge-small is ~3x faster than bge-m3 on CPU)
TEXT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
IMAGE_EMBEDDING_MODEL=clip-ViT-B-32
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=64

# Ingestion — disable heavy parsers on CPU for faster uploads
USE_DOCLING=false
USE_UNSTRUCTURED=false
ENABLE_OCR=false
USE_LLM_ENRICHMENT=false
ENABLE_IMAGE_PIXEL_EMBED=false

# Chunking Configuration (larger chunks = fewer embeddings = faster indexing)
CHUNK_SIZE=1024
CHUNK_OVERLAP=50
PARENT_CHUNK_SIZE=2048

# Retrieval Configuration
RETRIEVAL_METHOD=hybrid
TOP_K=8
RERANK_TOP_K=5
BM25_K1=1.5
BM25_B=0.75

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Data Directories
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
CHUNKS_DIR=./data/chunks
EMBEDDINGS_DIR=./data/embeddings

# OCR Configuration
TESSERACT_CMD=tesseract

# Phase 1 — Multi-Tenant Foundation
